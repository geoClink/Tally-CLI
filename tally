def cmd_stop(_args):
    data = load_data()
    active = data.get("active")
    if not active:
        raise TallyError("No active session.")
    hours = active_hours(active)
    started = active.get("started_at") or active["start"]
    end = now()
    segments = [(parse_dt(a), parse_dt(b)) for a, b in active.get("segments", [])]
    if not active.get("paused"):
        segments.append((parse_dt(active["start"]), end))
    repo = active.get("repo")
    proof = []
    if repo and os.path.isdir(repo) and segments:
        window = (segments[0][0], end)
        commits = my_commits(repo, *window)
        proof = [f"{sha} {subject}" for _, sha, subject, _ in commits]
        idle = load_config().get("idle_minutes", DEFAULT_IDLE_MINUTES)
        if idle:
            events = sorted([c[0] for c in commits] + file_saves(repo, *window))
            gaps = idle_gaps(segments, events, timedelta(minutes=idle))
            away = sum((b - a for a, b in gaps), timedelta())
            if away >= timedelta(minutes=1):
                spans = ", ".join(f"{fmt_time(a)}–{fmt_time(b)}" for a, b in gaps)
                print(f"  No file saves or commits for {fmt_hours(away.total_seconds() / 3600)} ({spans}).")
                if ask_yes(f"Remove it? {fmt_hours(hours)} → {fmt_hours(hours - away.total_seconds() / 3600)}"):
                    hours -= away.total_seconds() / 3600
                    if gaps[-1][1] >= end - timedelta(seconds=1):
                        end = gaps[-1][0]  # it ended when you stopped working, not when you typed stop
    session = {
        "client": active["client"],
        "start": started,
        "end": end.isoformat(),
        "hours": round(hours, 4),
        # The day it started, so a session that runs past midnight stays on the right day.
        "date": parse_dt(started).date().isoformat(),
        "note": active.get("note", ""),
        "sync": {"tally": "pending"},
    }
    if proof:
        session["proof"] = proof
    if active.get("jira_key"):
        session.update(jira_key=active["jira_key"], jira_summary=active.get("jira_summary"))
        session["sync"]["jira"] = "pending" if hours * 3600 >= 30 else "skipped"
    data["sessions"].append(session)
    data["active"] = None
    save_data(data)
    what = f"{session['jira_key']} ({session['client']})" if session.get("jira_key") else f"'{session['client']}'"
    print(f"  Stopped {what}: {fmt_hours(hours)}")
    sync(data)
    goal = load_config().get("goal", DEFAULT_GOAL)
    week_hours = total_hours(sessions_this_week(data["sessions"]))
    print(f"  This week: {fmt_hours(week_hours)} / {goal:.0f}h")
    check_warning(week_hours, goal)


def sync(data, quiet=False):
    """Send pending sessions to Tally and pending worklogs to Jira. Safe to run repeatedly."""
    config = load_config()
    pending = [s for s in data["sessions"] if "pending" in s.get("sync", {}).values()]
    if not pending:
        if not quiet:
            print("  Everything is synced.")
        return
    token = None
    for s in pending:
        label = s.get("jira_key") or s["client"]
        if s["sync"].get("tally") == "pending":
            if not config.get("tally"):
                print("  Saved on this Mac only. Run `tally login` to sync it to your Tally account.")
            else:
                try:
                    token = token or tally_access_token(config)
                    s["sync"]["tally"] = upload_session(config, token, s)
                    print(f"  ✓ Synced {label} to Tally")
                except TallyError as e:
                    print(f"  ✗ Tally: {e}. Retry with: tally sync")
        if s["sync"].get("jira") == "pending":
            try:
                require_jira(config)
                s["sync"]["jira"] = post_worklog(config, s)
                print(f"  ✓ Logged {fmt_hours(worklog_seconds(s['hours']) / 3600)} on {s['jira_key']} in Jira")
            except TallyError as e:
                print(f"  ✗ Jira: {e}. Retry with: tally sync")
        save_data(data)


def cmd_review(args):
    """Find work your commits show but no session covers, and offer to add it."""
    try:
        day = date.fromisoformat(args[0]) if args else date.today()
    except ValueError:
        raise TallyError("Usage: tally review [YYYY-MM-DD]")
    config = load_config()
    repos = [r for r in dict.fromkeys(config.get("repos", []) + [repo_root() or ""]) if r and os.path.isdir(r)]
    if not repos:
        raise TallyError("No repos yet. Start a timer inside a git repo once and tally remembers it.")
    since = datetime(day.year, day.month, day.day).astimezone()
    until = since + timedelta(days=1)
    data = load_data()
    covered = [(parse_dt(s["start"]), parse_dt(s["end"])) for s in data["sessions"]
               if not s.get("manual") and parse_dt(s["start"]) < until and parse_dt(s["end"]) > since]
    if data.get("active"):
        covered.append((parse_dt(data["active"].get("started_at") or data["active"]["start"]), now()))
    found = 0
    for repo in repos:
        commits = my_commits(repo, since, until)
        for block in work_blocks([c[0] for c in commits]):
            for start, end in uncovered(block, covered):
                inside = [c for c in commits if start - timedelta(minutes=30) <= c[0] <= end]
                tickets = [c[3] for c in inside if c[3]]
                ticket = max(set(tickets), key=tickets.count) if tickets else None
                found += 1
                minutes = round((end - start).total_seconds() / 60)
                what = ticket or os.path.basename(repo)
                print(f"\n  {fmt_time(start)}–{fmt_time(end)}: {len(inside)} commit(s) in {os.path.basename(repo)}"
                      f"{' on ' + ticket if ticket else ''}, nothing tracked")
                for _, sha, subject, _ in inside[:5]:
                    print(f"    {sha} {subject[:70]}")
                if not sys.stdin.isatty():
                    continue
                answer = input(f"  Add {fmt_hours(minutes / 60)} for {what}? [y/N/minutes] ").strip().lower()
                if answer.isdigit():
                    minutes = int(answer)
                elif answer not in ("y", "yes"):
                    continue
                if ticket and config.get("jira"):
                    client = client_for(config, ticket.split("-")[0])
                else:
                    client = input("  Client: ").strip() or "general"
                session = {"client": client, "start": start.isoformat(),
                           "end": (start + timedelta(minutes=minutes)).isoformat(), "hours": round(minutes / 60, 4),
                           "date": start.date().isoformat(), "note": "Added from commits by tally review",
                           "proof": [f"{sha} {subject}" for _, sha, subject, _ in inside], "sync": {"tally": "pending"}}
                if ticket and config.get("jira"):
                    session.update(jira_key=ticket)
                    session["sync"]["jira"] = "pending"
                data["sessions"].append(session)
                covered.append((start, end))
                save_data(data)
    if not found:
        print(f"  Nothing missing on {day.strftime('%b %d')}: every commit falls inside a tracked session.")
    else:
        sync(data, quiet=True)


