# ---------- storage ----------

def app_dir():
    return os.environ.get("TALLY_HOME") or os.path.expanduser("~/Library/Application Support/tally")


def data_path():
    return os.path.join(app_dir(), "data.json")


def config_path():
    return os.path.join(app_dir(), "config.json")


def migrate_legacy():
    # Older versions kept data in /Users/Shared, which every account on the Mac can read.
    if os.environ.get("TALLY_HOME") or os.path.exists(data_path()):
        return
    for name in ("data.json", "config.json"):
        src = os.path.join(LEGACY_DIR, name)
        if os.path.exists(src):
            os.makedirs(app_dir(), exist_ok=True)
            shutil.copy2(src, os.path.join(app_dir(), name))
            print(f"  Moved {name} to {app_dir()} (the old copy in {LEGACY_DIR} is untouched)")


def load_json(path, default):
    if not os.path.exists(path):
        return default
    with open(path) as f:
        return json.load(f)


def save_json(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(value, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def load_data():
    return load_json(data_path(), {"sessions": [], "active": None})


def save_data(data):
    save_json(data_path(), data)


def load_config():
    return load_json(config_path(), {"goal": DEFAULT_GOAL})


def save_config(config):
    save_json(config_path(), config)


# ---------- keychain (macOS `security`) ----------

def keychain_get(account):
    r = subprocess.run(["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", account, "-w"],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def keychain_set(account, secret):
    r = subprocess.run(["security", "add-generic-password", "-U", "-s", KEYCHAIN_SERVICE, "-a", account, "-w", secret],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise TallyError(f"Couldn't save to Keychain: {r.stderr.strip()}")


def keychain_delete(account):
    subprocess.run(["security", "delete-generic-password", "-s", KEYCHAIN_SERVICE, "-a", account],
                   capture_output=True, text=True)


# ---------- time ----------

def now():
    return datetime.now().astimezone()


def parse_dt(s):
    d = datetime.fromisoformat(s)
    # Sessions saved by older versions have no offset; they were local time.
    return d.astimezone() if d.tzinfo is None else d


def hours_between(start, end):
    return (parse_dt(end) - parse_dt(start)).total_seconds() / 3600


def week_bounds():
    today = date.today()
    monday = today - timedelta(days=today.weekday())
    return monday, monday + timedelta(days=6)


def sessions_this_week(sessions):
    monday, sunday = week_bounds()
    return [s for s in sessions if monday <= date.fromisoformat(s["date"]) <= sunday]


def total_hours(sessions):
    return sum(s.get("hours", 0.0) for s in sessions)


def hours_by_client(sessions):
    totals = {}
    for s in sessions:
        client = s.get("client", "unknown")
        totals[client] = totals.get(client, 0.0) + s.get("hours", 0.0)
    return totals


def fmt_hours(h):
    hrs = int(h)
    mins = int(round((h - hrs) * 60))
    if mins == 60:
        hrs, mins = hrs + 1, 0
    if hrs == 0:
        return f"{mins}m"
    if mins == 0:
        return f"{hrs}h"
    return f"{hrs}h {mins}m"


def check_warning(week_hours, goal):
    if week_hours >= goal:
        print(f"  WARNING: {fmt_hours(week_hours)} of {goal:.0f}h used")
    elif goal and week_hours / goal >= WARN_THRESHOLD:
        print(f"  Heads up: {fmt_hours(goal - week_hours)} remaining this week")


def active_hours(active):
    running = 0 if active.get("paused") else hours_between(active["start"], now().isoformat())
    return active.get("accumulated", 0.0) + running


# ---------- HTTP ----------

def http(method, url, headers=None, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers=dict(headers or {}))
    if data is not None:
        req.add_header("Content-Type", "application/json")
    req.add_header("Accept", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            raw = resp.read()
            return resp.status, (json.loads(raw) if raw else None)
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            return e.code, json.loads(raw)
        except ValueError:
            return e.code, {"message": raw.decode(errors="replace")[:200]}
    except urllib.error.URLError as e:
        raise TallyError(f"Network error: {e.reason}")


def error_text(payload):
    if isinstance(payload, dict):
        for k in ("error_description", "msg", "message", "error"):
            if payload.get(k):
                return str(payload[k])
        if payload.get("errorMessages"):
            return "; ".join(payload["errorMessages"])
        if payload.get("errors"):
            return "; ".join(f"{k}: {v}" for k, v in payload["errors"].items())
    return str(payload)


# ---------- Tally account (Supabase) ----------

def supabase_headers(token=None):
    return {"apikey": SUPABASE_ANON_KEY, "Authorization": f"Bearer {token or SUPABASE_ANON_KEY}"}


def save_auth(config, payload):
    keychain_set("supabase-refresh", payload["refresh_token"])
    config["tally"] = {"user_id": payload["user"]["id"], "email": payload["user"].get("email")}
    save_config(config)


def tally_access_token(config):
    """A fresh access token, rotating the stored refresh token. None when not signed in."""
    if not config.get("tally"):
        return None
    refresh = keychain_get("supabase-refresh")
    if not refresh:
        return None
    status, payload = http("POST", f"{SUPABASE_URL}/auth/v1/token?grant_type=refresh_token",
                           supabase_headers(), {"refresh_token": refresh})
    if status != 200:
        raise TallyError(f"Tally sign-in expired ({error_text(payload)}). Run: tally login")
    save_auth(config, payload)
    return payload["access_token"]


def cmd_login(args):
    config = load_config()
    email = args[0] if args else input("  Tally email: ").strip()
    password = getpass.getpass("  Tally password: ")
    status, payload = http("POST", f"{SUPABASE_URL}/auth/v1/token?grant_type=password",
                           supabase_headers(), {"email": email, "password": password})
    if status != 200:
        raise TallyError(f"Sign-in failed: {error_text(payload)}")
    save_auth(config, payload)
    print(f"  Signed in as {payload['user'].get('email')}. New sessions sync to your Tally account.")


def cmd_logout(_args):
    config = load_config()
    keychain_delete("supabase-refresh")
    config.pop("tally", None)
    save_config(config)
    print("  Signed out of Tally. Sessions stay on this Mac until you sign in again.")


def upload_session(config, token, session):
    jira_key = session.get("jira_key")
    note = session.get("note") or ""
    if jira_key:
        title = session.get("jira_summary") if config.get("jira", {}).get("store_titles") else None
        note = " ".join(p for p in (jira_key, title and f"{title}", note and f"· {note}") if p)
    body = {
        "user_id": config["tally"]["user_id"],
        "client": session["client"],
        "start_time": session["start"],
        "end_time": session["end"],
        "hours": session["hours"],
        "date": session["date"],
        "task_note": note or None,
        "is_manual": bool(session.get("manual")),
        "is_billable": True,
        "platform": "cli",
    }
    site = config.get("jira", {}).get("site")
    if jira_key and site:
        body.update(external_key=jira_key, external_url=f"https://{site}/browse/{jira_key}")
    headers = supabase_headers(token)
    headers["Prefer"] = "return=representation"
    status, payload = http("POST", f"{SUPABASE_URL}/rest/v1/sessions", headers, body)
    if status == 400 and "external_" in error_text(payload):
        # Database without the ticket-link columns yet: the key is still in the task note.
        body.pop("external_key", None)
        body.pop("external_url", None)
        status, payload = http("POST", f"{SUPABASE_URL}/rest/v1/sessions", headers, body)
    if status not in (200, 201):
        raise TallyError(f"Tally rejected the session: {error_text(payload)}")
    return payload[0]["id"]


# ---------- Jira ----------

def normalize_site(site):
    site = re.sub(r"^https?://", "", site.strip()).strip("/").split("/")[0]
    return site if "." in site else f"{site}.atlassian.net"


def jira_auth(config):
    jira = config.get("jira")
    if not jira:
        return None
    token = keychain_get("jira-token")
    if not token:
        raise TallyError("Jira token missing from Keychain. Run: tally jira connect")
    creds = base64.b64encode(f"{jira['email']}:{token}".encode()).decode()
    return f"https://api.atlassian.com/ex/jira/{jira['cloud_id']}/rest/api/3", {"Authorization": f"Basic {creds}"}


def jira_get(config, path):
    base, headers = jira_auth(config)
    status, payload = http("GET", base + path, headers)
    if status != 200:
        raise TallyError(f"Jira error {status}: {error_text(payload)}")
    return payload


def jira_issue(config, key):
    issue = jira_get(config, f"/issue/{urllib.parse.quote(key)}?fields=summary,project")
    return {"key": issue["key"], "summary": issue["fields"]["summary"], "project": issue["fields"]["project"]["key"]}


def jira_my_issues(config, limit=25):
    jql = "assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC"
    query = urllib.parse.urlencode({"jql": jql, "fields": "summary,status,project", "maxResults": limit})
    issues = jira_get(config, f"/search/jql?{query}").get("issues", [])
    return [{"key": i["key"], "summary": i["fields"]["summary"], "status": i["fields"]["status"]["name"],
             "project": i["fields"]["project"]["key"]} for i in issues]


def worklog_seconds(hours):
    # Jira's minimum is one minute; round to whole minutes like a person would.
    return max(60, int(round(hours * 60)) * 60)


def jira_started(iso):
    return parse_dt(iso).strftime("%Y-%m-%dT%H:%M:%S.000%z")


def post_worklog(config, session):
    base, headers = jira_auth(config)
    body = {"timeSpentSeconds": worklog_seconds(session["hours"]), "started": jira_started(session["start"])}
    if session.get("note"):
        body["comment"] = {"type": "doc", "version": 1,
                           "content": [{"type": "paragraph", "content": [{"type": "text", "text": session["note"]}]}]}
    status, payload = http("POST", f"{base}/issue/{urllib.parse.quote(session['jira_key'])}/worklog", headers, body)
    if status not in (200, 201):
        raise TallyError(f"Jira didn't accept the worklog: {error_text(payload)}")
    return payload["id"]


