# ---------- storage ----------

def app_dir():
    return os.environ.get("TALLY_HOME") or os.path.expanduser("~/Library/Application Support/tally")


def data_path():
    return os.path.join(app_dir(), "data.json")


def config_path():
    return os.path.join(app_dir(), "config.json")


def migrate_legacy():
    # Older versions kept data in /Users/Shared, which every account on the Mac can read.
    if os.environ.get("TALLY_HOME") or os.path.exists(data_path()):
        return
    for name in ("data.json", "config.json"):
        src = os.path.join(LEGACY_DIR, name)
        if os.path.exists(src):
            os.makedirs(app_dir(), exist_ok=True)
            shutil.copy2(src, os.path.join(app_dir(), name))
            print(f"  Moved {name} to {app_dir()} (the old copy in {LEGACY_DIR} is untouched)")


def load_json(path, default):
    if not os.path.exists(path):
        return default
    with open(path) as f:
        return json.load(f)


def save_json(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(value, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def load_data():
    return load_json(data_path(), {"sessions": [], "active": None})


def save_data(data):
    save_json(data_path(), data)


def load_config():
    return load_json(config_path(), {"goal": DEFAULT_GOAL})


def save_config(config):
    save_json(config_path(), config)


# ---------- keychain (macOS `security`) ----------

def keychain_get(account):
    r = subprocess.run(["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", account, "-w"],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def keychain_set(account, secret):
    r = subprocess.run(["security", "add-generic-password", "-U", "-s", KEYCHAIN_SERVICE, "-a", account, "-w", secret],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise TallyError(f"Couldn't save to Keychain: {r.stderr.strip()}")


def keychain_delete(account):
    subprocess.run(["security", "delete-generic-password", "-s", KEYCHAIN_SERVICE, "-a", account],
                   capture_output=True, text=True)


# ---------- time ----------

def now():
    return datetime.now().astimezone()


def parse_dt(s):
    d = datetime.fromisoformat(s)
    # Sessions saved by older versions have no offset; they were local time.
    return d.astimezone() if d.tzinfo is None else d


def hours_between(start, end):
    return (parse_dt(end) - parse_dt(start)).total_seconds() / 3600


def week_bounds():
    today = date.today()
    monday = today - timedelta(days=today.weekday())
    return monday, monday + timedelta(days=6)


def sessions_this_week(sessions):
    monday, sunday = week_bounds()
    return [s for s in sessions if monday <= date.fromisoformat(s["date"]) <= sunday]


def total_hours(sessions):
    return sum(s.get("hours", 0.0) for s in sessions)


def hours_by_client(sessions):
    totals = {}
    for s in sessions:
        client = s.get("client", "unknown")
        totals[client] = totals.get(client, 0.0) + s.get("hours", 0.0)
    return totals


def fmt_hours(h):
    hrs = int(h)
    mins = int(round((h - hrs) * 60))
    if mins == 60:
        hrs, mins = hrs + 1, 0
    if hrs == 0:
        return f"{mins}m"
    if mins == 0:
        return f"{hrs}h"
    return f"{hrs}h {mins}m"


def check_warning(week_hours, goal):
    if week_hours >= goal:
        print(f"  WARNING: {fmt_hours(week_hours)} of {goal:.0f}h used")
    elif goal and week_hours / goal >= WARN_THRESHOLD:
        print(f"  Heads up: {fmt_hours(goal - week_hours)} remaining this week")


def active_hours(active):
    running = 0 if active.get("paused") else hours_between(active["start"], now().isoformat())
    return active.get("accumulated", 0.0) + running


# ---------- HTTP ----------

def http(method, url, headers=None, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers=dict(headers or {}))
    if data is not None:
        req.add_header("Content-Type", "application/json")
    req.add_header("Accept", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            raw = resp.read()
            return resp.status, (json.loads(raw) if raw else None)
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            return e.code, json.loads(raw)
        except ValueError:
            return e.code, {"message": raw.decode(errors="replace")[:200]}
    except urllib.error.URLError as e:
        raise TallyError(f"Network error: {e.reason}")


def error_text(payload):
    if isinstance(payload, dict):
        for k in ("error_description", "msg", "message", "error"):
            if payload.get(k):
                return str(payload[k])
        if payload.get("errorMessages"):
            return "; ".join(payload["errorMessages"])
        if payload.get("errors"):
            return "; ".join(f"{k}: {v}" for k, v in payload["errors"].items())
    return str(payload)


# ---------- Tally account (Supabase) ----------

def supabase_headers(token=None):
    return {"apikey": SUPABASE_ANON_KEY, "Authorization": f"Bearer {token or SUPABASE_ANON_KEY}"}


def save_auth(config, payload):
    keychain_set("supabase-refresh", payload["refresh_token"])
    config["tally"] = {"user_id": payload["user"]["id"], "email": payload["user"].get("email")}
    save_config(config)


def tally_access_token(config):
    """A fresh access token, rotating the stored refresh token. None when not signed in."""
    if not config.get("tally"):
        return None
    refresh = keychain_get("supabase-refresh")
    if not refresh:
        return None
    status, payload = http("POST", f"{SUPABASE_URL}/auth/v1/token?grant_type=refresh_token",
                           supabase_headers(), {"refresh_token": refresh})
    if status != 200:
        raise TallyError(f"Tally sign-in expired ({error_text(payload)}). Run: tally login")
    save_auth(config, payload)
    return payload["access_token"]


def cmd_login(args):
