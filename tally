def require_jira(config):
    if not config.get("jira"):
        raise TallyError("Jira not connected. Run: tally jira connect")
    return config["jira"]


def client_for(config, project, ask=True):
    links = config.get("jira", {}).get("links", {})
    if project in links:
        return links[project]
    if not ask:
        return None
    client = input(f"  Which client is {project} for? ").strip()
    if not client:
        raise TallyError("No client given")
    if input(f"  Always bill {project} to '{client}'? [Y/n] ").strip().lower() in ("", "y", "yes"):
        config["jira"].setdefault("links", {})[project] = client
        save_config(config)
    return client


def branch_ticket():
    r = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    m = TICKET_RE.search(r.stdout.strip().upper())
    return m.group(1) if m else None


# ---------- activity (git + file saves) ----------

DEFAULT_IDLE_MINUTES = 20
GRACE = timedelta(minutes=5)       # you keep working a few minutes after a save, and think before the next one
SKIP_DIRS = {".git", "node_modules", "build", "dist", ".build", "DerivedData", "Pods", ".next", ".venv", "venv",
             "__pycache__", ".gradle", "vendor", "target", ".turbo", ".cache"}


def git(repo, *args):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def repo_root(path="."):
    r = subprocess.run(["git", "-C", path, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def my_commits(repo, since, until):
    """Your commits in [since, until] on any branch: [(time, short sha, subject, ticket)]."""
    email = git(repo, "config", "user.email")
    if not email:
        return []
    out = git(repo, "log", "--all", f"--author={email}", f"--since={since.isoformat()}",
              f"--until={until.isoformat()}", "--format=%cI%x1f%h%x1f%s%x1f%D")
    commits = []
    for line in filter(None, out.splitlines()):
        when, sha, subject, refs = (line.split("\x1f") + ["", "", ""])[:4]
        m = TICKET_RE.search(subject.upper()) or TICKET_RE.search(refs.upper())
        if not m:
            m = TICKET_RE.search(git(repo, "name-rev", "--name-only", sha).upper())
        commits.append((parse_dt(when), sha, subject, m.group(1) if m else None))
    return sorted(commits)


def file_saves(repo, since, until, limit=50000):
    """Times you saved files in the repo (skipping build output and dependencies)."""
    lo, hi, times, seen = since.timestamp(), until.timestamp(), [], 0
    for root, dirs, files in os.walk(repo):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS and not d.startswith(".")]
        for name in files:
            seen += 1
            if seen > limit:
                return sorted(times)
            try:
                m = os.stat(os.path.join(root, name)).st_mtime
            except OSError:
                continue
            if lo <= m <= hi:
                times.append(datetime.fromtimestamp(m).astimezone())
    return sorted(times)


def idle_gaps(segments, events, threshold):
    """Stretches inside the timed segments with no activity for longer than `threshold`.

    Starting the timer counts as activity, but the stretch right after it gets twice the
    allowance: people read the ticket and the code before they save anything. Each gap keeps
    GRACE after the last activity and GRACE before the next one, so only time clearly away
    is suggested for removal."""
    gaps = []
    for seg_start, seg_end in segments:
        points = [seg_start] + [e for e in events if seg_start < e <= seg_end]
        for i, (a, b) in enumerate(zip(points, points[1:] + [None])):
            tail = b is None
            b = seg_end if tail else b
            allowed = threshold * 2 if i == 0 and not tail else threshold
            if b - a > allowed:
                cut_start = a + GRACE
                cut_end = b if tail else b - GRACE
                if cut_end > cut_start:
                    gaps.append((cut_start, cut_end))
    return gaps


def work_blocks(times, join=timedelta(minutes=90), lead=timedelta(minutes=30)):
    """Group commit times into likely work blocks. Each block starts `lead` before its first commit."""
    blocks = []
    for t in sorted(times):
        if blocks and t - blocks[-1][1] <= join:
            blocks[-1][1] = t
        else:
            blocks.append([t - lead, t])
    return [tuple(b) for b in blocks]


def uncovered(block, covered, minimum=timedelta(minutes=15)):
    """Parts of `block` not inside any (start, end) in `covered`, each at least `minimum` long."""
    parts = [block]
    for c_start, c_end in covered:
        nxt = []
        for p_start, p_end in parts:
            if c_end <= p_start or c_start >= p_end:
                nxt.append((p_start, p_end))
                continue
            if c_start > p_start:
                nxt.append((p_start, c_start))
            if c_end < p_end:
                nxt.append((c_end, p_end))
        parts = nxt
    return [p for p in parts if p[1] - p[0] >= minimum]


def fmt_time(d):
    return d.strftime("%I:%M %p").lstrip("0")


def ask_yes(question, default=True):
    if not sys.stdin.isatty():
        return False
    answer = input(f"  {question} [{'Y/n' if default else 'y/N'}] ").strip().lower()
    return default if not answer else answer in ("y", "yes")


# ---------- timer ----------

def begin(client, issue=None, note=""):
    data = load_data()
    if data.get("active"):
        raise TallyError(f"Already tracking '{data['active']['client']}'. Run: tally stop")
    stamp = now().isoformat()
    data["active"] = {"client": client, "start": stamp, "started_at": stamp, "paused": False, "note": note,
                      "segments": []}
    repo = repo_root()
    if repo:
        data["active"]["repo"] = repo
        config = load_config()
        if repo not in config.setdefault("repos", []):
            config["repos"].append(repo)
            save_config(config)
    if issue:
        data["active"].update(jira_key=issue["key"], jira_summary=issue["summary"])
    save_data(data)
    label = f"{issue['key']} {issue['summary']} ({client})" if issue else f"'{client}'"
    print(f"  Started {label} at {now().strftime('%I:%M %p').lstrip('0')}")


def cmd_start(args):
    config = load_config()
    text = " ".join(args).strip()
    key = text.upper() if TICKET_RE.fullmatch(text.upper() or "-") else None
    if not text and config.get("jira"):
        key = branch_ticket()
        if key:
            print(f"  Branch points at {key}")
    if key:
        require_jira(config)
        issue = jira_issue(config, key)
        begin(client_for(config, issue["project"]), issue)
    else:
        begin(text or "general")


def cmd_tasks(_args):
    config = load_config()
    require_jira(config)
    issues = jira_my_issues(config)
    if not issues:
        print("  No open tickets assigned to you.")
        return
    width = max(len(i["key"]) for i in issues)
    for n, i in enumerate(issues, 1):
        client = client_for(config, i["project"], ask=False)
        tail = f"  → {client}" if client else ""
        print(f"  {n:>2}. {i['key']:<{width}}  {i['status'][:14]:<14}  {i['summary'][:60]}{tail}")
    pick = input("  Start which? (number, Enter to cancel) ").strip()
    if not pick:
        return
    if not pick.isdigit() or not 1 <= int(pick) <= len(issues):
        raise TallyError("Pick a number from the list")
    issue = issues[int(pick) - 1]
    begin(client_for(config, issue["project"]), issue)


