            raise TallyError(f"Couldn't find a Jira site at {site}")
        creds = base64.b64encode(f"{email}:{token}".encode()).decode()
        status, me = http("GET", f"https://api.atlassian.com/ex/jira/{info['cloudId']}/rest/api/3/myself",
                          {"Authorization": f"Basic {creds}"})
        if status != 200:
            raise TallyError(f"Jira rejected the token ({status}: {error_text(me)}). "
                             "It needs read:jira-work, write:jira-work and read:jira-user.")
        keychain_set("jira-token", token)
        previous = config.get("jira", {})
        config["jira"] = {"site": site, "email": email, "cloud_id": info["cloudId"],
                          "account_id": me.get("accountId"), "name": me.get("displayName"),
                          "store_titles": previous.get("store_titles", False), "links": previous.get("links", {})}
        save_config(config)
        print(f"  Connected to {site} as {me.get('displayName')}.")
        print("  Next: tally jira link <PROJECT KEY> \"<Client>\"   then   tally tasks")
    elif sub == "link":
        if len(args) < 3:
            raise TallyError('Usage: tally jira link <PROJECT KEY> "<Client name>"')
        jira = require_jira(config)
        key = args[1].upper()
        jira.setdefault("links", {})[key] = " ".join(args[2:])
        save_config(config)
        print(f"  {key} tickets now bill to '{jira['links'][key]}'")
    elif sub == "unlink":
        jira = require_jira(config)
        removed = jira.get("links", {}).pop(args[1].upper(), None) if len(args) > 1 else None
        save_config(config)
        print(f"  Unlinked {args[1].upper()}" if removed else "  No such link")
    elif sub == "titles":
        jira = require_jira(config)
        if len(args) > 1:
            jira["store_titles"] = args[1].lower() in ("on", "yes", "true")
            save_config(config)
        state = "on: ticket titles are saved to Tally" if jira.get("store_titles") else "off: only ticket keys are saved to Tally"
        print(f"  Titles {state}")
    elif sub == "disconnect":
        keychain_delete("jira-token")
        config.pop("jira", None)
        save_config(config)
        print("  Disconnected from Jira and removed the token from Keychain.")
    elif sub == "status":
        jira = config.get("jira")
        if not jira:
            print("  Jira not connected. Run: tally jira connect")
            return
        print(f"  Jira: {jira['site']} as {jira.get('name')}")
        for k, c in sorted(jira.get("links", {}).items()):
            print(f"    {k} → {c}")
        print(f"  Titles in Tally: {'on' if jira.get('store_titles') else 'off'}")
    else:
        raise TallyError("Usage: tally jira connect | link KEY \"Client\" | unlink KEY | titles on|off | status | disconnect")


def require_jira(config):
    if not config.get("jira"):
        raise TallyError("Jira not connected. Run: tally jira connect")
    return config["jira"]


def client_for(config, project, ask=True):
    links = config.get("jira", {}).get("links", {})
    if project in links:
        return links[project]
    if not ask:
        return None
    client = input(f"  Which client is {project} for? ").strip()
    if not client:
        raise TallyError("No client given")
    if input(f"  Always bill {project} to '{client}'? [Y/n] ").strip().lower() in ("", "y", "yes"):
        config["jira"].setdefault("links", {})[project] = client
        save_config(config)
    return client


def branch_ticket():
    r = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    m = TICKET_RE.search(r.stdout.strip().upper())
    return m.group(1) if m else None


# ---------- timer ----------

def begin(client, issue=None, note=""):
    data = load_data()
    if data.get("active"):
        raise TallyError(f"Already tracking '{data['active']['client']}'. Run: tally stop")
    stamp = now().isoformat()
    data["active"] = {"client": client, "start": stamp, "started_at": stamp, "paused": False, "note": note}
    if issue:
        data["active"].update(jira_key=issue["key"], jira_summary=issue["summary"])
    save_data(data)
    label = f"{issue['key']} {issue['summary']} ({client})" if issue else f"'{client}'"
    print(f"  Started {label} at {now().strftime('%I:%M %p').lstrip('0')}")


def cmd_start(args):
    config = load_config()
    text = " ".join(args).strip()
    key = text.upper() if TICKET_RE.fullmatch(text.upper() or "-") else None
    if not text and config.get("jira"):
        key = branch_ticket()
        if key:
            print(f"  Branch points at {key}")
    if key:
        require_jira(config)
        issue = jira_issue(config, key)
        begin(client_for(config, issue["project"]), issue)
    else:
        begin(text or "general")


def cmd_tasks(_args):
    config = load_config()
    require_jira(config)
    issues = jira_my_issues(config)
    if not issues:
        print("  No open tickets assigned to you.")
        return
    width = max(len(i["key"]) for i in issues)
    for n, i in enumerate(issues, 1):
        client = client_for(config, i["project"], ask=False)
        tail = f"  → {client}" if client else ""
        print(f"  {n:>2}. {i['key']:<{width}}  {i['status'][:14]:<14}  {i['summary'][:60]}{tail}")
    pick = input("  Start which? (number, Enter to cancel) ").strip()
    if not pick:
        return
    if not pick.isdigit() or not 1 <= int(pick) <= len(issues):
        raise TallyError("Pick a number from the list")
    issue = issues[int(pick) - 1]
    begin(client_for(config, issue["project"]), issue)


def cmd_pause(_args):
    data = load_data()
    active = data.get("active")
    if not active:
        raise TallyError("No active session.")
    if active.get("paused"):
        raise TallyError("Already paused.")
    active["accumulated"] = active_hours(active)
    active["paused"] = True
    save_data(data)
    print(f"  Paused '{active['client']}' at {fmt_hours(active['accumulated'])}")


def cmd_resume(args):
    data = load_data()
    active = data.get("active")
    if not active:
        cmd_start(args)
        return
    if not active.get("paused"):
        raise TallyError("Already running.")
    active["start"] = now().isoformat()
    active["paused"] = False
    save_data(data)
    print(f"  Resumed '{active['client']}'")


def cmd_note(args):
    data = load_data()
    if not data.get("active"):
        raise TallyError("No active session.")
    data["active"]["note"] = " ".join(args)
    save_data(data)
    print("  Note saved")


def cmd_stop(_args):
    data = load_data()
    active = data.get("active")
    if not active:
        raise TallyError("No active session.")
    hours = active_hours(active)
    started = active.get("started_at") or active["start"]
    session = {
        "client": active["client"],
        "start": started,
        "end": now().isoformat(),
        "hours": round(hours, 4),
        # The day it started, so a session that runs past midnight stays on the right day.
        "date": parse_dt(started).date().isoformat(),
        "note": active.get("note", ""),
        "sync": {"tally": "pending"},
    }
    if active.get("jira_key"):
        session.update(jira_key=active["jira_key"], jira_summary=active.get("jira_summary"))
        session["sync"]["jira"] = "pending" if hours * 3600 >= 30 else "skipped"
    data["sessions"].append(session)
    data["active"] = None
    save_data(data)
    what = f"{session['jira_key']} ({session['client']})" if session.get("jira_key") else f"'{session['client']}'"
    print(f"  Stopped {what}: {fmt_hours(hours)}")
    sync(data)
    goal = load_config().get("goal", DEFAULT_GOAL)
    week_hours = total_hours(sessions_this_week(data["sessions"]))
    print(f"  This week: {fmt_hours(week_hours)} / {goal:.0f}h")
    check_warning(week_hours, goal)


def sync(data, quiet=False):
    """Send pending sessions to Tally and pending worklogs to Jira. Safe to run repeatedly."""
    config = load_config()
    pending = [s for s in data["sessions"] if "pending" in s.get("sync", {}).values()]
    if not pending:
        if not quiet:
            print("  Everything is synced.")
        return
    token = None
    for s in pending:
        label = s.get("jira_key") or s["client"]
        if s["sync"].get("tally") == "pending":
            if not config.get("tally"):
                print("  Saved on this Mac only. Run `tally login` to sync it to your Tally account.")
            else:
                try:
                    token = token or tally_access_token(config)
                    s["sync"]["tally"] = upload_session(config, token, s)
                    print(f"  ✓ Synced {label} to Tally")
                except TallyError as e:
                    print(f"  ✗ Tally: {e}. Retry with: tally sync")
        if s["sync"].get("jira") == "pending":
            try:
                require_jira(config)
                s["sync"]["jira"] = post_worklog(config, s)
                print(f"  ✓ Logged {fmt_hours(worklog_seconds(s['hours']) / 3600)} on {s['jira_key']} in Jira")
            except TallyError as e:
                print(f"  ✗ Jira: {e}. Retry with: tally sync")
        save_data(data)


def cmd_sync(_args):
    sync(load_data())


def cmd_status(_args):
    data = load_data()
    config = load_config()
    goal = config.get("goal", DEFAULT_GOAL)
    active = data.get("active")
    if active:
        state = "paused" if active.get("paused") else "running"
        what = f"{active['jira_key']} {active.get('jira_summary', '')} ({active['client']})" if active.get("jira_key") else f"'{active['client']}'"
        print(f"  {what} {state}: {fmt_hours(active_hours(active))} so far")
    else:
        print("  No active session")
    today = date.today().isoformat()
    print(f"  Today: {fmt_hours(total_hours([s for s in data['sessions'] if s.get('date') == today]))}")
    week = sessions_this_week(data["sessions"])
    week_hours = total_hours(week)
    monday, sunday = week_bounds()
    filled = min(int((week_hours / goal) * 20), 20) if goal else 0
    print(f"  Week ({monday.strftime('%b %d')} - {sunday.strftime('%b %d')}): {fmt_hours(week_hours)} / {goal:.0f}h")
    print(f"  [{'█' * filled}{'░' * (20 - filled)}] {int((week_hours / goal) * 100) if goal else 0}%")
    check_warning(week_hours, goal)
    by_client = hours_by_client(week)
    if by_client:
        print("  Breakdown:")
        for c, h in sorted(by_client.items(), key=lambda x: -x[1]):
            print(f"    {c}: {fmt_hours(h)}")
    unsynced = sum(1 for s in data["sessions"] if "pending" in s.get("sync", {}).values())
    if unsynced:
        print(f"  {unsynced} session(s) waiting to sync. Run: tally sync")
    accounts = []
    accounts.append(f"Tally: {config['tally']['email']}" if config.get("tally") else "Tally: not signed in")
    accounts.append(f"Jira: {config['jira']['site']}" if config.get("jira") else "Jira: not connected")
    print("  " + " · ".join(accounts))


def cmd_report(_args):
    data = load_data()
    goal = load_config().get("goal", DEFAULT_GOAL)
    print("  All-time:")
    all_clients = hours_by_client(data["sessions"])
    if all_clients:
        for c, h in sorted(all_clients.items(), key=lambda x: -x[1]):
            print(f"    {c}: {fmt_hours(h)}")
        print(f"    Total: {fmt_hours(total_hours(data['sessions']))}")
    else:
        print("    No sessions yet.")
    week = sessions_this_week(data["sessions"])
    monday, sunday = week_bounds()
    print(f"\n  This week ({monday.strftime('%b %d')} - {sunday.strftime('%b %d')}): {fmt_hours(total_hours(week))} / {goal:.0f}h")
    check_warning(total_hours(week), goal)
    for c, h in sorted(hours_by_client(week).items(), key=lambda x: -x[1]):
        print(f"    {c}: {fmt_hours(h)}")


def cmd_add(args):
    if len(args) < 2:
        raise TallyError("Usage: tally add <client> <hours> [YYYY-MM-DD]")
    client, hours_str = args[0], args[1]
    try:
        hours = float(hours_str)
    except ValueError:
        raise TallyError(f"Invalid hours: '{hours_str}'")
    try:
        day = date.fromisoformat(args[2]) if len(args) > 2 else date.today()
    except ValueError:
        raise TallyError(f"Invalid date: '{args[2]}'")
    start = datetime(day.year, day.month, day.day).astimezone()
    data = load_data()
    data["sessions"].append({"client": client, "start": start.isoformat(),
                             "end": (start + timedelta(hours=hours)).isoformat(), "hours": round(hours, 4),
                             "date": day.isoformat(), "manual": True, "note": "", "sync": {"tally": "pending"}})
    save_data(data)
    print(f"  Added {fmt_hours(hours)} for '{client}' on {day.strftime('%b %d, %Y')}")
    sync(data, quiet=True)


def cmd_goal(args):
    config = load_config()
    if not args:
        print(f"  Goal: {config.get('goal', DEFAULT_GOAL):.0f}h/week")
        return
    try:
        config["goal"] = float(args[0])
    except ValueError:
        raise TallyError(f"Invalid: '{args[0]}'")
    save_config(config)
    print(f"  Weekly goal set to {config['goal']:.0f}h")


USAGE = """Usage: tally <command>

  start [client | TICKET-123]   start a timer (in a git repo, the branch's ticket is used)
  tasks                         pick one of your open Jira tickets and start it
  pause | resume | stop         stop saves to Tally and logs the time in Jira
  note <text>                   add a note to the running session
  status | report               this week, by client
  add <client> <hours> [date]   log time by hand
  goal <hours>                  weekly goal
  sync                          retry anything that didn't reach Tally or Jira
  login | logout                your Tally account
  jira connect | link KEY "Client" | titles on|off | status | disconnect"""

COMMANDS = {"start": cmd_start, "tasks": cmd_tasks, "pause": cmd_pause, "resume": cmd_resume, "stop": cmd_stop,
            "note": cmd_note, "status": cmd_status, "report": cmd_report, "add": cmd_add, "goal": cmd_goal,
            "sync": cmd_sync, "login": cmd_login, "logout": cmd_logout, "jira": cmd_jira}


def main(argv):
    migrate_legacy()
    command = argv[0] if argv else "status"
    if command in ("help", "-h", "--help"):
        print(USAGE)
        return 0
    handler = COMMANDS.get(command)
    if not handler:
        print(USAGE)
        return 1
    try:
        handler(argv[1:])
        return 0
    except TallyError as e:
        print(f"  {e}")
        return 1
    except (KeyboardInterrupt, EOFError):
        print()
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
